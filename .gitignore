# Only two kinds of files are kept out of this repository:
#   1. secrets
#   2. anything a command recreates on the machine that clones it
#
# Everything else is committed, including the trained models and the
# training checkpoints, so a fresh clone runs without retraining.

# ---- Secrets -----------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# ---- Recreated by "npm install" ----------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Recreated by "npm run dev" or "npm run build" ---------------------
.next/
**/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts
.vercel

# ---- Recreated by "pip install -r requirements.txt" --------------------
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---- Written by the application while it runs --------------------------
# The X-ray images patients upload. They belong to rows in a database
# that a fresh clone does not have, so they are of no use elsewhere, and
# they are medical images in a public repository.
backend/storage/

# The old local database file, replaced by MariaDB in Docker.
backend/legacy-sqlite/
*.db
*.sqlite
*.sqlite3

# ---- Logs and editor noise ---------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store

# ---- Datasets ----------------------------------------------------------
# 41 GB of raw X-rays from public datasets. GitHub refuses a repository
# this size, so they cannot live here. ai-service/scripts/prepare_*.py
# rebuilds every one of them from its original download; see the README.
ai-service/data/

# ---- Written while a model trains ---------------------------------------
# The weights and the metrics are kept, because a clone should run without
# retraining. These are the noise around them: one log per run, the queue's
# own progress file, and a copy of a model taken before it was retrained.
ai-service/models/*_train.log
ai-service/models/progress.log
ai-service/models/_backup_*/
