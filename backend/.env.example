BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8001
DATABASE_URL=mysql://root@127.0.0.1:3307/radiocare

# Mail settings.
#
# Without these, approving a patient still creates the account, but the
# sign in details are printed to the terminal instead of being emailed,
# and the admin has to hand them over in person.
#
# For a Gmail account: switch on two step verification, then create an
# app password at https://myaccount.google.com/apppasswords and put the
# 16 characters in SMTP_PASS. The normal account password is refused.
#
# Check the settings with: node scripts/check-email.mjs you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="RadioCare" <your-address@gmail.com>

# Some networks - university Wi-Fi, some antivirus products - inspect
# encrypted traffic and present their own certificate instead of the
# mail server's. Sending then fails with "self-signed certificate in
# certificate chain" even though nothing about the account changed. On
# such a network set this to true: the message stays encrypted, but the
# server's identity is no longer verified, so leave it out anywhere
# other than a development machine.
SMTP_ALLOW_SELF_SIGNED=false

# The address the sign in link in the email points at.
APP_PUBLIC_URL=http://localhost:3000
